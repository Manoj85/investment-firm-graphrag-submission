# Copy to .env locally. Never put actual credentials in this example.
# Shell environment variables take precedence over values in .env.
NEBIUS_API_KEY=
# Official Token Factory API base; confirm if your account specifies another region.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Chat writes the answer; embeddings produce vectors for passage/question search.
# Copy exact identifiers from the current account catalog, then verify tiny calls.
NEBIUS_CHAT_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

PINECONE_API_KEY=
PINECONE_INDEX=investment-firm-graphrag
PINECONE_NAMESPACE=development-v1
# Explicit setup defaults; confirm your account supports this serverless region.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Only source files beneath outputs/corpus may be ingested.
CORPUS_DIR=outputs/corpus
CHUNK_MAX_TOKENS=256
CHUNK_OVERLAP=32
# Opt-in development experiment; changing this requires matching ingestion.
EMBEDDING_DOCUMENT_CONTEXT=false

LANGSMITH_API_KEY=
LANGSMITH_PROJECT=investment-firm-graphrag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Keep tracing off until we intentionally introduce provider calls and traces.
LANGSMITH_TRACING=false
